# Copy to .env.dev and fill in real values. Never commit the filled-in file.
# Used by: docker compose -f docker-compose.dev.yml --env-file .env.dev -p aicompliance-dev up -d
#
# This is a separate database/app instance from production - do not reuse prod
# credentials here, and don't point STORAGE_BUCKET at the prod bucket.

DB_NAME=aicompliance_dev
DB_USERNAME=aicompliance_dev
DB_PASSWORD=change-me-to-a-strong-password

JWT_SECRET=change-me-to-a-different-long-random-secret-than-prod

# Host ports this environment is reachable on (must not collide with anything else
# running on the server, including the prod stack's Caddy on 80/443)
BACKEND_HOST_PORT=8081
FRONTEND_HOST_PORT=8080

FRONTEND_URL=http://31.97.205.56:8080

# Can point at the same SMTP provider as prod, or a separate sandbox/test account
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Use a SEPARATE bucket (or prefix) from production to avoid mixing dev and real data
STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
STORAGE_REGION=us-east-1
STORAGE_BUCKET=aicompliance-certificates-dev
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PATH_STYLE=false

OPENAI_API_KEY=sk-...
