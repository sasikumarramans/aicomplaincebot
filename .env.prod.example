# Copy to .env.prod and fill in real values. Never commit the filled-in file.
# Used by: docker compose -f docker-compose.prod.yml --env-file .env.prod up -d

DB_NAME=aicompliance
DB_USERNAME=aicompliance
DB_PASSWORD=change-me-to-a-strong-password

# 32+ random bytes, e.g.: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret

# Public URL of the deployed frontend (used to build links in emails, e.g. password reset).
# IP-only: http://your.server.ip  |  With a domain later: https://app.example.com
FRONTEND_URL=http://31.97.205.56

# Address Caddy serves on.
# IP-only (no domain): use the bare port ":80" - Caddy serves plain HTTP, no TLS attempted
#   (Let's Encrypt cannot issue a certificate for a raw IP address).
# With a domain: set this to the domain itself (e.g. app.example.com) - Caddy will
#   automatically provision and renew a real HTTPS certificate, no other changes needed.
SITE_ADDRESS=:80

# Real SMTP provider (SES, SendGrid, Postmark, etc.) - not MailHog
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Real S3 (or S3-compatible) bucket - not MinIO
STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
STORAGE_REGION=us-east-1
STORAGE_BUCKET=aicompliance-certificates-prod
STORAGE_ACCESS_KEY=
STORAGE_SECRET_KEY=
STORAGE_PATH_STYLE=false

OPENAI_API_KEY=sk-...

# How many days of local Postgres backups to retain before deleting older ones
BACKUP_RETENTION_DAYS=14
